{
  "schema_version": "1.0",
  "policy_id": "access-incident-risk",
  "version": "0.1.0",
  "rules": [
    {
      "rule_id": "allow-normal-user-auto-unlock",
      "operation": "iam.unlock_account",
      "risk_level": "L1",
      "decision": "AUTO_ALLOW",
      "conditions": {
        "employment_status": "ACTIVE",
        "account_active": true,
        "is_admin": false,
        "lock_reason": "auto_lock"
      }
    }
  ],
  "default_decision": "DENY"
}

